# Hotel AI Assistant - Development Environment Template
# Copy this file to .env.development and fill in your actual values

# API Keys
LLM_API_KEY=[Your Groq API Key]
EMBEDDING_API_KEY=[Your Google Gemini API Key]
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1

# Hotel Configuration
HOTEL_NAME=[Hotel Name]
HOTEL_LOCATION=[Hotel Location]
HOTEL_STARS=[Hotel Stars, e.g., 4]
HOTEL_PHONE=[Hotel Phone, e.g., +351 (XX) XXXX-XXXX]
HOTEL_EMAIL=[Hotel Email, e.g., info@hotel.com]

# API Keys (empty = no auth in development)
API_KEYS=["dev-key-12345"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=minute

# Redis (for conversation memory)
REDIS_URL=[redis://localhost:6379/0]

# Conversation Memory
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=50

# PostgreSQL
POSTGRES_HOST=[localhost]
POSTGRES_PORT=[5432]
POSTGRES_DB=[hotel_ai]
POSTGRES_USER=[hotel_user]
POSTGRES_PASSWORD=[hotel_pass]
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json